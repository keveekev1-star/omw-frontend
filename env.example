# ─────────────────────────────────────────────────────────────────────────────
# On My Way — Frontend Environment Variables
# Copy to .env.local for local development (never commit .env.local)
# In Vercel: paste into Project Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# Auth0 SPA Client ID (NOT the M2M secret — SPAs have no secret)
# Get from: Auth0 Dashboard → Applications → your SPA app → Client ID
REACT_APP_AUTH0_CLIENT_ID=YOUR_SPA_CLIENT_ID_HERE

# Your Render backend URL (get after first Render deploy)
# Local: http://localhost:4000
# Production: https://on-my-way-api.onrender.com
REACT_APP_API_URL=http://localhost:4000
